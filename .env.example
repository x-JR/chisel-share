# MySQL / MariaDB params
MYSQL_ROOT_PASSWORD=changeme1
DB_NAME=chisel
DB_USER=chisel
DB_PASSWORD=changeme2


# Root directory: textures served from {DATA_DIR}/textures, schematic data stored in {DATA_DIR}/data
DATA_DIR=./

# Port (default: 3000)
PORT=3000

# Admin token — set to any secret string; import it via "My Token" to manage all schematics
# ADMIN_TOKEN=change-me-to-a-strong-secret

# Public base URL — used in Discord webhook links (no trailing slash)
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Discord webhook URL — if set, a Discord alert is sent whenever a collection is reported
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
