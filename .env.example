# MySQL / MariaDB connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=chisel
DB_PASSWORD=changeme
DB_NAME=chisel

# Root directory: textures served from {DATA_DIR}/textures, schematic data stored in {DATA_DIR}/data
DATA_DIR=./

# Port (default: 3000)
PORT=3000

# Admin token — set to any secret string; import it via "My Token" to manage all schematics
# ADMIN_TOKEN=change-me-to-a-strong-secret
